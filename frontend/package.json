  "scripts": {
    "start": "craco start",
    "build": "GENERATE_SOURCEMAP=false craco build",
    "test": "craco test",
    "cap:sync": "npm run check:web-build && cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "build:android": "GENERATE_SOURCEMAP=false REACT_APP_CAPACITOR_OFFLINE=true craco build",
    "lint": "eslint src --ext .js,.jsx",
    "test:ci": "craco test --watchAll=false --runInBand",
    "android:prepare": "python3 ../scripts/prepare_android.py",
    "android:setup": "cap add android",
    "android:verify": "python3 ../scripts/verify_android.py",
    "release:debug": "npm run build:android && npm run cap:sync && npm run android:prepare && npm run apk:debug",
    "test:adapters": "node --experimental-vm-modules ../scripts/tests/adapters.test.mjs",
    "check:source": "node --expose-internals ../scripts/check-source.cjs",
    "check:web-build": "node ../scripts/verify_web_build.cjs",
    "prebuild": "node ../scripts/prepare-ui-assets.cjs",
    "prebuild:android": "node ../scripts/prepare-ui-assets.cjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
