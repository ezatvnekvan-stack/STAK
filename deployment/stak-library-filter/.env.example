# Template only: copy to .env privately and replace every placeholder.
STAK_UID=1000
STAK_GID=1000
FILTER_BIND=127.0.0.1
STAK_ACCESS_TOKEN=REPLACE_WITH_A_NEW_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
TORBOX_API_KEY=REPLACE_WITH_YOUR_ACCOUNT_KEY
ZURG_SOURCE_DIR=/path/to/existing/zurg-mount/__all__
ZURG_MOUNT_DIR=/path/to/existing/zurg-mount
STAK_LIBRARY_DIR=/path/to/private/stak-library
STAK_STATE_DIR=/path/to/private/stak-state
# Optional address reachable FROM this container, not from the Android device.
JELLYFIN_URL=
JELLYFIN_API_KEY=
SCAN_ON_CHANGE=false
CHECK_SECONDS=60
