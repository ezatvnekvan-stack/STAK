<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android cannot express CIDR ranges. Arbitrary LAN server addresses require a
         cleartext base policy. App transport restricts HTTP to LAN addresses. -->
    <base-config cleartextTrafficPermitted="true"><trust-anchors><certificates src="system" /></trust-anchors></base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">torbox.app</domain>
        <domain includeSubdomains="true">themoviedb.org</domain>
        <domain includeSubdomains="true">tmdb.org</domain>
        <domain includeSubdomains="true">omdbapi.com</domain>
        <domain includeSubdomains="true">youtube.com</domain>
        <domain includeSubdomains="true">youtube-nocookie.com</domain>
        <domain includeSubdomains="true">strem.io</domain>
        <domain includeSubdomains="true">strem.fun</domain>
    </domain-config>
</network-security-config>
