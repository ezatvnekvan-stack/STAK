# Fresh install only. Existing installations: python3 migrate.py prepare
STAK_WATCHER_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
STAK_TORBOX_KEY=REPLACE_WITH_YOUR_ACCOUNT_KEY
STAK_ADDONS=
STAK_JELLYFIN_URL=
STAK_JELLYFIN_USER=
STAK_JELLYFIN_TOKEN=
STAK_JELLYFIN_SCAN=1
STAK_BIND_HOST=0.0.0.0
STAK_BIND_PORT=8055
STAK_LAYOUT=organized
ZURG_SOURCE_DIR=/path/to/zurg/__all__
STAK_LIBRARY_DIR=/path/to/stak-library
JELLYFIN_ZURG_ROOT=/media/zurg/__all__
# Optional compatibility listener, still inside the one STAK Server container.
STAK_LEGACY_FILTER_PORT=
STAK_LEGACY_FILTER_TOKEN=
STAK_LEGACY_FILTER_BIND=127.0.0.1
